{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",

    "declaration": true,
    "declarationMap": true,

    "emitDeclarationOnly": false,

    "module": "nodenext",
    "moduleResolution": "nodenext",

    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "composite": true,

    "allowJs": true,
    "checkJs": false,

    "skipLibCheck": true,
    "noEmit": false
  },
  "include": ["src/**/*", "generated/**/*"],
  "exclude": ["node_modules", "dist",]
}