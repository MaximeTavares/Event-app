{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "declaration": true,
    "declarationMap": true,

    "emitDeclarationOnly": false,

    "module": "nodenext",
    "moduleResolution": "nodenext",

    "tsBuildInfoFile": "./dist/.tsbuildinfo",

    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}